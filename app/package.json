{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "assets:fetch": "node scripts/fetch-sample-assets.mjs",
    "assets:compress": "node scripts/compress-model.mjs assets-source/sheen-chair.original.glb public/models/sheen-chair.glb && node scripts/compress-model.mjs assets-source/sheen-sofa.original.glb public/models/sheen-sofa.glb && node scripts/compress-model.mjs assets-source/commercial-refrigerator.original.glb public/models/commercial-refrigerator.glb",
    "assets:build": "npm run assets:fetch && npm run assets:compress",
    "test:e2e": "rm -rf .nyc_output coverage && playwright test",
    "coverage:report": "node scripts/coverage-report.mjs",
    "coverage:check": "node scripts/coverage-report.mjs",
    "test:e2e:coverage": "npm run test:e2e && npm run coverage:report"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/model-viewer": "^4.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "dxf-parser": "^1.1.2",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3dgltf": "^1.5.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "nyc": "^18.0.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
